{
	"name": "@zenotds/wp_devkit",
	"version": "8.0",
	"description": "Zeno's WP DevKit",
	"scripts": {
		"postinstall": "[ -e ../../../wp-config.php ] && ln -sf ../../../wp-config.php ./wp-config.php || echo 'wp-config.php non trovato (devkit standalone): symlink saltato'",
		"dev": "NODE_ENV=development node esbuild.js",
		"watch": "npm run dev",
		"prod": "NODE_ENV=production node esbuild.js",
		"build": "npm run prod",
		"make:block": "node dev/make-block.mjs",
		"make:module": "node dev/make-module.mjs"
	},
	"type": "module",
	"author": "Francesco Selva",
	"license": "MIT",
	"funding": {
		"type": "individual",
		"url": "https://paypal.me/zenotds"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"browser-sync": "^3.0.4",
		"chalk": "^6.0.0",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.2",
		"postcss": "^8.5.28"
	},
	"dependencies": {
		"@alpinejs/collapse": "^3.17.3",
		"@alpinejs/focus": "^3.17.3",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"alpinejs": "^3.17.3",
		"countup.js": "^2.10.1",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"mixitup": "^3.3.2",
		"mixitup-multifilter": "^3.3.7",
		"swiper": "^14.2.0",
		"tailwindcss": "^4.3.3",
		"venobox": "^2.2.0",
		"vlitejs": "^8.1.1"
	}
}
