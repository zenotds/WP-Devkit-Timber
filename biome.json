{
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/vendor",
            "!**/dist",
            "!**/assets",
            "!**/acf-json",
            "!**/xd",
            "!**/*.min.js",
            "!**/*.min.css"
        ]
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
