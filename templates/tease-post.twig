{# Card articolo per gli archivi (index.twig, search.twig). Un CPT che compare in archivio porta il suo `tease-<post_type>.twig`: non c'è più un tease generico di riserva, così un tease mancante si nota subito #}
<article class="tease tease-{{ post.type }}" id="tease-{{ post.id }}">
	<h2 class="title typo-h text-h4"><a href="{{ post.link }}">{{ post.title }}</a></h2>
	<p>{{ post.excerpt({ words: 30, read_more: '' }) }}</p>
	{% if post.thumbnail %}
		<img src="{{ post.thumbnail.src }}" alt="{{ post.thumbnail.alt }}" loading="lazy" decoding="async">
	{% endif %}
</article>
