{# Archivio (categorie, tag, tassonomie, date, CPT): riusa il loop di index.twig e aggiunge la descrizione del termine. Titolo e termine arrivano da archive.php. Un archivio-landing di progetto sostituisce questi testi coi campi ACF sul termine #}
{% extends "index.twig" %}

{% block intro %}
	{{ parent() }}
	{% if category.description %}
		<div class="description typo-r">{{ category.description }}</div>
	{% endif %}
{% endblock %}
