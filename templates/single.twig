{% extends "base.twig" %}
{% import '/partial/macros.twig' as macros %}

{% block content %}
	<div class="content-wrapper">
		<article class="post-type-{{ post.post_type }}" id="post-{{ post.ID }}">
			{# .content-wrapper non ha larghezza propria: l'immagine è a tutta pagina. ratio tiene la fascia 4:1 che il vecchio resize(1200, 300) otteneva croppando #}
			{% if post.thumbnail %}{{ macros.image(post.thumbnail, { sizes: '100vw', ratio: '4/1', atf: true }) }}{% endif %}
			<section class="article-content">
				<h1 class="title typo-h text-h1">{{ post.title }}</h1>
				<p class="meta">
					<time datetime="{{ post.date('Y-m-d') }}">{{ post.date }}</time>
				</p>
				<div class="article-body typo-r">
					{{ post.content }}
				</div>
			</section>
		</article>
	</div>
{% endblock %}
