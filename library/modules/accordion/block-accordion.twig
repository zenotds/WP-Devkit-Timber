{# Modulo Accordion — elenco di voci espandibili, nessun JSON-LD. Dipendenze: Alpine + plugin collapse (x-collapse), FA icons (fa-chevron-down) #}
{% set tag = content.tag|default('h2') %}
{% set bg = content.bg|default('none') %}

<section class="block-accordion" id="{{ content.section_id|default('section-' ~ loop.index) }}" data-loop="{{ loop.index }}"{% if bg != 'none' %} data-bg="{{ bg }}"{% endif %}>
    <div class="container mx-auto">

        {% if content.title or content.subtitle %}
            <div class="intro mx-auto mb-10 max-w-3xl text-center xl:mb-14">
                {% if content.title %}
                    <{{ tag }} class="title typo-h text-{{ tag }}">{{ content.title }}</{{ tag }}>
                {% endif %}
                {% if content.subtitle %}
                    <p class="subtitle text-lead mt-3">{{ content.subtitle }}</p>
                {% endif %}
            </div>
        {% endif %}

        {% if content.items %}
            <div class="accordion mx-auto flex max-w-3xl flex-col gap-4" x-data="{ active: null }">
                {% for item in content.items %}
                    <div class="accordion-item surface rounded-xl bg-light">
                        <button type="button" class="accordion-trigger flex w-full cursor-pointer items-center gap-4 px-6 py-5 text-left" @click="active = active === {{ loop.index }} ? null : {{ loop.index }}" :aria-expanded="active === {{ loop.index }}" aria-controls="accordion-{{ loop.parent.loop.index }}-{{ loop.index }}">
                            <span class="title typo-h text-h5 flex-1">{{ item.title }}</span>
                            <i class="fa fa-chevron-down shrink-0 text-accent transition-transform duration-300" :class="{ 'rotate-180': active === {{ loop.index }} }" aria-hidden="true"></i>
                        </button>
                        <div id="accordion-{{ loop.parent.loop.index }}-{{ loop.index }}" x-show="active === {{ loop.index }}" x-collapse x-cloak>
                            <div class="text typo-r px-6 pb-6">{{ item.text }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
